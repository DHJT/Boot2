<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://flowable.org/bpmn">
  <process id="leaveProcess" name="请假审批流程（含驳回重提）" isExecutable="true">
    <!-- 开始事件 -->
    <startEvent id="startEvent" flowable:formKey="leaveForm">
      <extensionElements>
        <flowable:formProperty id="applicantName" name="申请人姓名" type="string" required="true"/>
        <flowable:formProperty id="reason" name="请假原因" type="string" required="true"/>
        <flowable:formProperty id="days" name="请假天数" type="int" required="true"/>
        <flowable:formProperty id="deptName" name="所属部门" type="string" required="true"/>
        <!-- 流程启动由 GlobalProcessEventListener 统一处理 -->
      </extensionElements>
    </startEvent>
    <!-- 提交申请（用户任务） - 使用 skipExpression 当驳回时不自动跳过 -->
    <userTask id="submitLeave" name="提交请假申请" flowable:assignee="${applicantName}" flowable:formKey="leaveForm"
              flowable:skipExpression="${skipSubmitterWhenBackToSubmitter == true}">
      <extensionElements>
        <flowable:formProperty id="applicantName" name="申请人姓名" type="string"/>
        <flowable:formProperty id="reason" name="请假原因" type="string"/>
        <flowable:formProperty id="days" name="请假天数" type="int"/>
        <flowable:formProperty id="deptName" name="所属部门" type="string"/>
        <!-- 任务事件由 GlobalProcessEventListener 统一处理 -->
      </extensionElements>
    </userTask>
    <!-- 服务任务：调用 DMN 决策委托进行综合评估（天数判断+部门判断） -->
    <serviceTask id="dmnEvaluation" name="DMN决策评估" flowable:delegateExpression="${dmnEvaluationDelegate}"/>
    <!-- 排他网关：根据 DMN 决策结果判断审批流向 -->
    <exclusiveGateway id="gatewayDays" name="天数|部门判断"/>
    <!-- 辅导员审批 - 由张三、李四两人审批（candidateUsers 配合 IDM 引擎实现） -->
    <userTask id="advisorApproval" name="辅导员审批" flowable:candidateUsers="zhangsan,lisi" flowable:formKey="advisorForm">
      <extensionElements>
        <flowable:formProperty id="approved" name="是否同意" type="boolean" required="true"/>
        <flowable:formProperty id="comment" name="审批意见" type="string"/>
        <!-- 任务事件由 GlobalProcessEventListener 统一处理 -->
      </extensionElements>
    </userTask>
    <!-- 院长审批 -->
    <userTask id="deanApproval" name="院长审批" flowable:candidateGroups="dean" flowable:formKey="deanForm">
      <extensionElements>
        <flowable:formProperty id="approved" name="是否同意" type="boolean" required="true"/>
        <flowable:formProperty id="comment" name="审批意见" type="string"/>
        <!-- 任务事件由 GlobalProcessEventListener 统一处理 -->
      </extensionElements>
    </userTask>
    <!-- 审批结果网关：同意→结束；拒绝→退回提交人重新提交（完整审批闭环） -->
    <exclusiveGateway id="gatewayApprovalResult" name="审批结果判断" default="flowResultToEndDefault"/>
    <!-- 结束事件（终止/结束均由全局监听器处理） -->
    <endEvent id="endEvent">
      <extensionElements>
        <!-- 流程结束由 GlobalProcessEventListener 统一处理 -->
      </extensionElements>
    </endEvent>
    <!-- 连线 -->
    <sequenceFlow id="flowStartToSubmit" sourceRef="startEvent" targetRef="submitLeave"/>
    <sequenceFlow id="flowSubmitToDmn" sourceRef="submitLeave" targetRef="dmnEvaluation"/>
    <sequenceFlow id="flowDmnToGateway" sourceRef="dmnEvaluation" targetRef="gatewayDays"/>
    <!-- DMN 决策结果为 short（短假）且部门不需要院长审批 -> 辅导员审批 -->
    <sequenceFlow id="flowGatewayToAdvisor" sourceRef="gatewayDays" targetRef="advisorApproval">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${finalNeedDeanApproval == false}]]></conditionExpression>
    </sequenceFlow>
    <!-- DMN 决策结果为 long（长假）或部门规则要求院长审批 -> 院长审批 -->
    <sequenceFlow id="flowGatewayToDean" sourceRef="gatewayDays" targetRef="deanApproval">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${finalNeedDeanApproval == true}]]></conditionExpression>
    </sequenceFlow>
    <!-- 辅导员/院长审批完成后统一汇入审批结果网关 -->
    <sequenceFlow id="flowAdvisorToResult" sourceRef="advisorApproval" targetRef="gatewayApprovalResult"/>
    <sequenceFlow id="flowDeanToResult" sourceRef="deanApproval" targetRef="gatewayApprovalResult"/>
    <!-- 拒绝：退回提交人重新提交（双模式兼容：Boolean approved=false 或 String approval='rejected'） -->
    <sequenceFlow id="flowResultToResubmit" sourceRef="gatewayApprovalResult" targetRef="submitLeave">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved == false || "rejected".equals(approval)}]]></conditionExpression>
    </sequenceFlow>
    <!-- 同意：结束（双模式兼容：Boolean approved=true 或 String approval='approved'） -->
    <sequenceFlow id="flowResultToEnd" sourceRef="gatewayApprovalResult" targetRef="endEvent">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved == true || "approved".equals(approval)}]]></conditionExpression>
    </sequenceFlow>
    <!-- 兜底默认流：结束 -->
    <sequenceFlow id="flowResultToEndDefault" sourceRef="gatewayApprovalResult" targetRef="endEvent"/>
  </process>
  <!-- BPMN 图形信息定义 -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_leaveProcess">
    <bpmndi:BPMNPlane bpmnElement="leaveProcess" id="BPMNPlane_leaveProcess">
      <!-- 开始事件 -->
      <bpmndi:BPMNShape id="shape_startEvent" bpmnElement="startEvent">
        <omgdc:Bounds x="60.0" y="140.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="58" y="176" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- 提交请假申请 -->
      <bpmndi:BPMNShape id="shape_submitLeave" bpmnElement="submitLeave">
        <omgdc:Bounds x="160" y="118" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <!-- DMN决策评估（服务任务） -->
      <bpmndi:BPMNShape id="shape_dmnEvaluation" bpmnElement="dmnEvaluation">
        <omgdc:Bounds x="310" y="118" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <!-- 排他网关（菱形） -->
      <bpmndi:BPMNShape id="shape_gatewayDays" bpmnElement="gatewayDays">
        <omgdc:Bounds x="470" y="133" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <!-- 辅导员审批（上方） -->
      <bpmndi:BPMNShape id="shape_advisorApproval" bpmnElement="advisorApproval">
        <omgdc:Bounds x="590" y="75" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <!-- 院长审批（下方） -->
      <bpmndi:BPMNShape id="shape_deanApproval" bpmnElement="deanApproval">
        <omgdc:Bounds x="590" y="165" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <!-- 结束事件 -->
      <bpmndi:BPMNShape id="shape_endEvent" bpmnElement="endEvent">
        <omgdc:Bounds x="760" y="136" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="758" y="176" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- 连线：开始 -> 提交申请 -->
      <bpmndi:BPMNEdge id="edge_flowStartToSubmit" bpmnElement="flowStartToSubmit">
        <omgdi:waypoint x="96.0" y="158.0"/>
        <omgdi:waypoint x="160" y="158"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：提交申请 -> DMN决策评估 -->
      <bpmndi:BPMNEdge id="edge_flowSubmitToDmn" bpmnElement="flowSubmitToDmn">
        <omgdi:waypoint x="260" y="158"/>
        <omgdi:waypoint x="310" y="158"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：DMN决策评估 -> 网关 -->
      <bpmndi:BPMNEdge id="edge_flowDmnToGateway" bpmnElement="flowDmnToGateway">
        <omgdi:waypoint x="410" y="158"/>
        <omgdi:waypoint x="470" y="158"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：网关 -> 辅导员审批（finalNeedDeanApproval=false） -->
      <bpmndi:BPMNEdge id="edge_flowGatewayToAdvisor" bpmnElement="flowGatewayToAdvisor">
        <omgdi:waypoint x="495" y="158"/>
        <omgdi:waypoint x="540" y="115"/>
        <omgdi:waypoint x="590" y="115"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：网关 -> 院长审批（finalNeedDeanApproval=true） -->
      <bpmndi:BPMNEdge id="edge_flowGatewayToDean" bpmnElement="flowGatewayToDean">
        <omgdi:waypoint x="495" y="158"/>
        <omgdi:waypoint x="540" y="190"/>
        <omgdi:waypoint x="590" y="205"/>
      </bpmndi:BPMNEdge>
      <!-- 审批结果网关（菱形，位于结束事件下方） -->
      <bpmndi:BPMNShape id="shape_gatewayApprovalResult" bpmnElement="gatewayApprovalResult">
        <omgdc:Bounds x="760" y="245" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="748" y="295" width="80" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- 连线：辅导员审批 -> 审批结果网关 -->
      <bpmndi:BPMNEdge id="edge_flowAdvisorToResult" bpmnElement="flowAdvisorToResult">
        <omgdi:waypoint x="690" y="115"/>
        <omgdi:waypoint x="785" y="115"/>
        <omgdi:waypoint x="785" y="245"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：院长审批 -> 审批结果网关 -->
      <bpmndi:BPMNEdge id="edge_flowDeanToResult" bpmnElement="flowDeanToResult">
        <omgdi:waypoint x="690" y="205"/>
        <omgdi:waypoint x="735" y="220"/>
        <omgdi:waypoint x="735" y="270"/>
        <omgdi:waypoint x="760" y="270"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：审批结果网关 -> 退回提交人（驳回） -->
      <bpmndi:BPMNEdge id="edge_flowResultToResubmit" bpmnElement="flowResultToResubmit">
        <omgdi:waypoint x="785" y="295"/>
        <omgdi:waypoint x="210" y="320"/>
        <omgdi:waypoint x="210" y="198"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：审批结果网关 -> 结束（同意） -->
      <bpmndi:BPMNEdge id="edge_flowResultToEnd" bpmnElement="flowResultToEnd">
        <omgdi:waypoint x="810" y="270"/>
        <omgdi:waypoint x="830" y="270"/>
        <omgdi:waypoint x="830" y="154"/>
        <omgdi:waypoint x="760" y="154"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：审批结果网关 -> 结束（兜底默认流） -->
      <bpmndi:BPMNEdge id="edge_flowResultToEndDefault" bpmnElement="flowResultToEndDefault">
        <omgdi:waypoint x="760" y="250"/>
        <omgdi:waypoint x="740" y="250"/>
        <omgdi:waypoint x="740" y="154"/>
        <omgdi:waypoint x="760" y="154"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
