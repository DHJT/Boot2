<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://flowable.org/bpmn">
  <process id="leaveProcess" name="请假审批流程" isExecutable="true">
    <!-- 开始事件 -->
    <startEvent id="startEvent" flowable:formKey="leaveForm">
      <extensionElements>
        <flowable:formProperty id="applicantName" name="申请人姓名" type="string" required="true"/>
        <flowable:formProperty id="reason" name="请假原因" type="string" required="true"/>
        <flowable:formProperty id="days" name="请假天数" type="int" required="true"/>
        <flowable:executionListener event="start" class="tech.dhjt.boot3.listener.ProcessStartListener"/>
      </extensionElements>
    </startEvent>
    <!-- 提交申请（用户任务） -->
    <userTask id="submitLeave" name="提交请假申请" flowable:assignee="${applicantName}" flowable:formKey="leaveForm" flowable:taskListenerType="create">
      <extensionElements>
        <flowable:formProperty id="applicantName" name="申请人姓名" type="string"/>
        <flowable:formProperty id="reason" name="请假原因" type="string"/>
        <flowable:formProperty id="days" name="请假天数" type="int"/>
        <flowable:taskListener event="create" class="tech.dhjt.boot3.listener.LeaveTaskListener"/>
        <flowable:taskListener event="complete" class="tech.dhjt.boot3.listener.LeaveTaskListener"/>
      </extensionElements>
    </userTask>
    <!-- 排他网关：根据请假天数判断是否需要院长审批 -->
    <exclusiveGateway id="gatewayDays" name="天数判断"/>
    <!-- 辅导员审批 -->
    <userTask id="advisorApproval" name="辅导员审批" flowable:candidateGroups="advisor" flowable:formKey="advisorForm">
      <extensionElements>
        <flowable:formProperty id="approved" name="是否同意" type="boolean" required="true"/>
        <flowable:formProperty id="comment" name="审批意见" type="string"/>
        <flowable:taskListener event="create" class="tech.dhjt.boot3.listener.LeaveTaskListener"/>
        <flowable:taskListener event="complete" class="tech.dhjt.boot3.listener.LeaveTaskListener"/>
      </extensionElements>
    </userTask>
    <!-- 院长审批 -->
    <userTask id="deanApproval" name="院长审批" flowable:candidateGroups="dean" flowable:formKey="deanForm">
      <extensionElements>
        <flowable:formProperty id="approved" name="是否同意" type="boolean" required="true"/>
        <flowable:formProperty id="comment" name="审批意见" type="string"/>
        <flowable:taskListener event="create" class="tech.dhjt.boot3.listener.LeaveTaskListener"/>
        <flowable:taskListener event="complete" class="tech.dhjt.boot3.listener.LeaveTaskListener"/>
      </extensionElements>
    </userTask>
    <!-- 结束事件 -->
    <endEvent id="endEvent">
      <extensionElements>
        <flowable:executionListener event="end" class="tech.dhjt.boot3.listener.ProcessEndListener"/>
      </extensionElements>
    </endEvent>
    <!-- 连线 -->
    <sequenceFlow id="flowStartToSubmit" sourceRef="startEvent" targetRef="submitLeave"/>
    <sequenceFlow id="flowSubmitToGateway" sourceRef="submitLeave" targetRef="gatewayDays"/>
    <sequenceFlow id="flowGatewayToAdvisor" sourceRef="gatewayDays" targetRef="advisorApproval">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${days <= 3}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowGatewayToDean" sourceRef="gatewayDays" targetRef="deanApproval">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${days > 3}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowAdvisorToEnd" sourceRef="advisorApproval" targetRef="endEvent"/>
    <sequenceFlow id="flowDeanToEnd" sourceRef="deanApproval" targetRef="endEvent"/>
  </process>
  <!-- BPMN 图形信息定义 -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_leaveProcess">
    <bpmndi:BPMNPlane bpmnElement="leaveProcess" id="BPMNPlane_leaveProcess">
      <!-- 开始事件 -->
      <bpmndi:BPMNShape id="shape_startEvent" bpmnElement="startEvent">
        <omgdc:Bounds x="100.0" y="104.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="98" y="140" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- 提交请假申请 -->
      <bpmndi:BPMNShape id="shape_submitLeave" bpmnElement="submitLeave">
        <omgdc:Bounds x="200" y="82" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <!-- 排他网关（菱形） -->
      <bpmndi:BPMNShape id="shape_gatewayDays" bpmnElement="gatewayDays">
        <omgdc:Bounds x="360" y="97" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <!-- 辅导员审批（上方） -->
      <bpmndi:BPMNShape id="shape_advisorApproval" bpmnElement="advisorApproval">
        <omgdc:Bounds x="480" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <!-- 院长审批（下方） -->
      <bpmndi:BPMNShape id="shape_deanApproval" bpmnElement="deanApproval">
        <omgdc:Bounds x="480" y="140" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <!-- 结束事件 -->
      <bpmndi:BPMNShape id="shape_endEvent" bpmnElement="endEvent">
        <omgdc:Bounds x="650" y="100" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds x="648" y="140" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <!-- 连线：开始 -> 提交申请 -->
      <bpmndi:BPMNEdge id="edge_flowStartToSubmit" bpmnElement="flowStartToSubmit">
        <omgdi:waypoint x="136.0" y="122.0"/>
        <omgdi:waypoint x="200" y="122"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：提交申请 -> 网关 -->
      <bpmndi:BPMNEdge id="edge_flowSubmitToGateway" bpmnElement="flowSubmitToGateway">
        <omgdi:waypoint x="300" y="122"/>
        <omgdi:waypoint x="360" y="122"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：网关 -> 辅导员审批 （≤3天） -->
      <bpmndi:BPMNEdge id="edge_flowGatewayToAdvisor" bpmnElement="flowGatewayToAdvisor">
        <omgdi:waypoint x="385" y="122"/>
        <omgdi:waypoint x="430" y="100"/>
        <omgdi:waypoint x="480" y="100"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：网关 -> 院长审批 （>3天） -->
      <bpmndi:BPMNEdge id="edge_flowGatewayToDean" bpmnElement="flowGatewayToDean">
        <omgdi:waypoint x="385" y="122"/>
        <omgdi:waypoint x="430" y="150"/>
        <omgdi:waypoint x="480" y="160"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：辅导员审批 -> 结束 -->
      <bpmndi:BPMNEdge id="edge_flowAdvisorToEnd" bpmnElement="flowAdvisorToEnd">
        <omgdi:waypoint x="580" y="100"/>
        <omgdi:waypoint x="650" y="118"/>
      </bpmndi:BPMNEdge>
      <!-- 连线：院长审批 -> 结束 -->
      <bpmndi:BPMNEdge id="edge_flowDeanToEnd" bpmnElement="flowDeanToEnd">
        <omgdi:waypoint x="580" y="160"/>
        <omgdi:waypoint x="650" y="118"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
