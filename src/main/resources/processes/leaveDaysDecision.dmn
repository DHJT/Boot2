<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DMN/20151101"
             xmlns:flowable="http://flowable.org/dmn"
             id="leaveDaysDecisionDefs"
             name="请假天数决策"
             namespace="http://flowable.org/dmn">
    <decision id="leaveDaysDecision" name="请假天数判断决策">
        <extensionElements>
            <flowable:description>根据请假天数判断请假类别（short/long），作为基础决策表供综合评估引用</flowable:description>
        </extensionElements>
        <informationRequirement>
            <requiredInput href="#inputDays"/>
        </informationRequirement>
        <decisionTable id="decisionTableDays" hitPolicy="UNIQUE">
            <input id="inputDays" label="请假天数" flowable:type="integer">
                <inputExpression id="inputExpressionDays" typeRef="integer">
                    <text>days</text>
                </inputExpression>
            </input>
            <output id="outputCategory" label="请假类别" name="leaveCategory" typeRef="string"/>
            <output id="outputTmp1" label="类别说明" name="output_1" typeRef="string"/>
            <rule id="ruleShort">
                <description>短假：不超过3天</description>
                <inputEntry id="entryShort">
                    <text><![CDATA[<= 3]]></text>
                </inputEntry>
                <outputEntry id="outputShort">
                    <text><![CDATA["short"]]></text>
                </outputEntry>
                <outputEntry id="outputShortTmp1">
                    <text><![CDATA["正常"]]></text>
                </outputEntry>
            </rule>
            <rule id="ruleLong">
                <description>长假：超过3天</description>
                <inputEntry id="entryLong">
                    <text><![CDATA[> 3]]></text>
                </inputEntry>
                <outputEntry id="outputLong">
                    <text><![CDATA["long"]]></text>
                </outputEntry>
                <outputEntry id="outputLongTmp1">
                    <text><![CDATA["异常"]]></text>
                </outputEntry>
            </rule>
        </decisionTable>
    </decision>
</definitions>
